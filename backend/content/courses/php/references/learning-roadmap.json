  "dependency_principles": [
    "Arrays and functions should precede advanced object-oriented architecture.",
    "Types, classes, and namespaces should precede serious Composer-based package development.",
    "HTTP fundamentals should precede API implementation.",
    "Validation and security fundamentals should precede authentication and upload features.",
    "Database basics should precede repositories and transaction-heavy architecture.",
    "Testing fundamentals should precede sophisticated CI/CD practices.",
    "Performance measurement should precede optimization.",
    "Core PHP should precede optional framework specialization."
  ],
