{
  "id": "rust-final-exam-blueprint",
  "title": "Rust Core Skills Assessment Blueprint",
  "status": "published",
  "recommended_settings": {
    "duration_minutes": 120,
    "suggested_pass_percent": 75,
    "attempts": "Follow CodeLeaf platform exam policy; this blueprint does not change live attempt limits."
  },
  "assessment_type": "Mixed single-choice knowledge checks plus human-reviewed coding projects; repository question keys remain protected.",
  "outcomes": [
    "Use Rust syntax, types, control flow, and functions to solve small problems.",
    "Explain ownership, borrowing, lifetimes, enums, traits, generics, and error handling.",
    "Create Cargo packages with tests, documentation, and repeatable workflows.",
    "Reason about I/O, collections, concurrency, async, and security boundaries.",
    "Choose and scope optional networking, database, embedded, WebAssembly, or low-level tracks with official references."
  ],
  "topic_distribution": [
    {
      "topic": "Introduction, toolchain, syntax, types, control flow, functions",
      "lesson_range": [
        1,
        52
      ],
      "weight_percent": 20
    },
    {
      "topic": "Ownership, data modelling, collections",
      "lesson_range": [
        53,
        95
      ],
      "weight_percent": 20
    },
    {
      "topic": "Generics, traits, errors, modules, lifetimes, iterators",
      "lesson_range": [
        96,
        157
      ],
      "weight_percent": 20
    },
    {
      "topic": "I/O, smart pointers, concurrency, async",
      "lesson_range": [
        158,
        210
      ],
      "weight_percent": 15
    },
    {
      "topic": "Testing, documentation, macros, unsafe and FFI",
      "lesson_range": [
        211,
        247
      ],
      "weight_percent": 10
    },
    {
      "topic": "Networking, databases, performance, security and production",
      "lesson_range": [
        248,
        293
      ],
      "weight_percent": 10
    },
    {
      "topic": "Embedded, WebAssembly, professional workflow",
      "lesson_range": [
        294,
        322
      ],
      "weight_percent": 5
    }
  ],
  "question_file_strategy": "Every lesson has a separate protected three-question knowledge-check file. The current importer does not create a live exam runner from this blueprint; the existing lesson knowledge-check API can serve prompt/options when the course and question set are published. Keep answer keys and explanations out of public lesson responses.",
