{
  "app": "multi-vendor-commerce",
  "collections": [
    "customers",
    "vendors",
    "products",
    "carts",
    "orders",
    "inventoryEvents"
  ],
  "requiredArtifacts": [
    "schema rationale",
    "index rationale",
    "API contract and tests",
    "aggregation reports",
    "security checklist",
    "benchmark report",
    "backup/restore evidence",
    "deployment and recovery runbooks"
  ],
  "invariants": [
    "purchase-time line-item prices are immutable",
    "stock cannot become negative",
    "order state transitions are validated",
    "vendor access is authorized server-side"
  ]
}
