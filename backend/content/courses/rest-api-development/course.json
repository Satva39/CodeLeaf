  "course": {
    "id": "rest-api-development-course",
    "slug": "rest-api-development",
    "title": "REST API Development — From Foundations to Production Practice",
    "description": "A framework-independent, visual-first REST API engineering course that progresses from APIs, REST constraints, HTTP semantics, resource design and JSON through CRUD, querying, validation, databases, identity, API security, OpenAPI, testing, caching, asynchronous integrations, lifecycle management, reliability, deployment, observability, distributed architecture, specialized patterns and professional governance.",
    "category": "Backend & APIs",
    "level": "Beginner to Professional",
    "sort_order": 0,
    "version_scope": "Framework-independent curriculum. HTTP semantics are grounded in RFC 9110, caching in RFC 9111, problem details in RFC 9457, URI syntax in RFC 3986, JSON in RFC 8259, OAuth security in RFC 9700, and OpenAPI in the currently listed OAS versions. Worked contract fragments target broad compatibility, generally OAS 3.1.2 unless stated. Reviewed for course preparation on 2026-10-19; verify versions and tooling again before publication.",
    "audience": [
      "beginners learning backend development",
      "frontend developers integrating services",
      "backend engineers",
      "mobile and web platform developers",
      "developers preparing services for production"
    ],
    "prerequisites": [
      "Basic computer literacy is sufficient to start. Familiarity with URLs, JSON, and one programming language is helpful during implementation.",
      "A local runtime, an API client, and a disposable test database are useful for projects; framework-specific setup is selected by the learner."
    ],
    "estimated_workload_hours": 120,
    "estimated_workload_range_hours": [
      80,
      140
    ],
    "module_count": 24,
    "lesson_count": 240,
    "exercise_count": 30,
    "project_count": 11,
    "assessment_count": 1,
    "learning_outcomes": [
      "Explain the difference between API contracts, REST constraints, and HTTP semantics.",
      "Design resource identifiers, methods, status codes, JSON representations, and collection-query contracts.",
      "Implement and test CRUD operations with validation, persistence, transactions, and consistent errors.",
      "Apply authentication and authorization, including object ownership and least privilege.",
      "Document API contracts with OpenAPI and verify behavior through automated and contract tests.",
      "Use caching, conditional requests, idempotency, rate limits, asynchronous jobs, webhooks, and failure handling deliberately.",
      "Deploy and operate APIs with secure configuration, TLS, observability, recovery plans, versioning, and governance."
    ],
