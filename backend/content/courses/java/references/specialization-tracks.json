{
  "status": "draft",
  "description": "Optional learning tracks from Section E of Java.pdf. These are intentionally separate from the required 336-lesson Java SE path.",
  "tracks": [
    {
      "id": "java-track-advanced-core",
      "title": "Advanced Core Java",
      "level": "advanced",
      "topics": [
        "Reflection",
        "Method handles",
        "Annotation processing",
        "Service Provider Interface",
        "Foreign Function and Memory API",
        "Low-level JVM work",
        "Advanced generics",
        "Advanced concurrency",
        "Garbage-collection tuning",
        "Native access and JNI"
      ],
      "note": "Specialist topics; native access and FFM require careful safety and platform review."
    },
    {
      "id": "java-track-desktop",
      "title": "Java Desktop Application Development",
      "level": "specialization",
      "topics": [
        "GUI fundamentals",
        "JavaFX setup and project structure",
        "Stages, scenes, controls, layouts, and events",
        "Properties and data binding",
        "Table views, lists, and forms",
        "CSS styling for JavaFX",
        "Background tasks and responsiveness",
        "FXML and controller organization",
        "GUI testing and accessibility",
        "Packaging with jpackage"
      ],
      "note": "JavaFX is a separate desktop UI framework, not a required Java language feature."
    },
    {
      "id": "java-track-backend",
      "title": "Java Backend and Web Development",
      "level": "specialization",
      "topics": [
        "HTTP and REST fundamentals",
        "Backend framework setup and configuration",
        "Routing and request handling",
        "Validation and structured errors",
        "Persistence and transaction boundaries",
        "Authentication and authorization",
        "Observability",
        "Integration testing",
        "Packaging and deployment"
      ],
      "note": "Frameworks such as Spring or Jakarta EE need version-specific separate course content."
    },
    {
      "id": "java-track-android",
      "title": "Android Development with Java",
      "level": "specialization",
      "topics": [
        "Android environment",
        "Application and activity concepts",
        "Layouts and UI components",
        "Event handling and lifecycle",
        "Resources and localization",
        "Background work",
        "Local persistence",
        "Network communication",
        "Runtime permissions",
        "Testing and release preparation"
      ],
      "note": "Android APIs and application lifecycle are separate from standard Java SE."
    },
    {
      "id": "java-track-data",
      "title": "Data Engineering and Analytics",
      "level": "specialization",
      "topics": [
        "Large-file processing",
        "Streaming and batching",
        "CSV, JSON, and structured formats",
        "Database extraction",
        "Data transformation pipelines",
        "Concurrent processing",
        "Memory-aware processing",
        "Performance measurement",
        "Data-platform integration",
        "Data validation and reliable output"
      ]
    },
    {
      "id": "java-track-ai",
      "title": "AI and Machine Learning Applications with Java",
      "level": "specialization",
      "topics": [
        "Math and ML prerequisites",
        "Calling AI model APIs over HTTP",
        "JSON request/response handling",
        "Embeddings and vector search",
        "Model-serving integration",
        "Data preparation and validation",
        "Latency, retries, and rate limits",
        "Model output validation",
        "Privacy, security, cost, and evaluation",
        "Observability for AI features"
      ],
      "note": "This is AI-system integration, not a replacement for a machine-learning theory course."
    },
    {
      "id": "java-track-performance",
      "title": "Performance Engineering",
      "level": "specialization",
      "topics": [
        "Profiling methodology",
        "Microbenchmarking and JMH",
        "CPU and allocation profiling",
        "Garbage-collection analysis",
        "Thread contention and deadlock analysis",
        "JFR event analysis",
        "Memory layout and object allocation",
        "Startup-time optimization",
        "Latency versus throughput",
        "Evidence-based JVM tuning"
      ]
    },
    {
      "id": "java-track-release",
      "title": "Modern Java Release Laboratory",
      "level": "specialization",
      "topics": [
        "Release notes and migration guides",
        "Standardized language features",
        "API additions and removals",
        "Deprecation and compatibility changes",
        "Preview and incubating features",
        "Current versus LTS JDK behavior",
        "Version-specific examples",
        "Regression-tested upgrades"
      ]
    }
  ]
}
