{
  "id": "pytorch-final-assessment-blueprint",
  "title": "PyTorch — Final Knowledge and Portfolio Assessment",
  "status": "draft",
  "recommended_settings": {
    "duration_minutes": 120,
    "suggested_pass_percent": 75,
    "attempts": "Follow the platform exam policy; this blueprint does not change live attempt limits."
  },
  "assessment_type": "Mixed protected single-choice knowledge checks, practical exercises, and a human-reviewed portfolio capstone.",
  "outcomes": [
    "Explain tensors, automatic differentiation, neural-network construction, and the training loop.",
    "Prepare datasets, evaluate generalization, and perform error analysis.",
    "Save and restore reproducible artifacts with appropriate trust boundaries.",
    "Use device placement, profiling, compilation, export, or distribution where justified by requirements.",
    "Test, document, and deploy a model with clear performance limits and responsible-use notes."
  ],
  "topic_distribution": [
    {
      "topic": "Introduction, setup, tensors, and memory layouts",
      "lesson_range": [
        1,
        30
      ],
      "weight_percent": 18
    },
    {
      "topic": "Autograd, neural-network modules, and data pipelines",
      "lesson_range": [
        31,
        56
      ],
      "weight_percent": 18
    },
    {
      "topic": "Training, architecture, evaluation, and responsible assessment",
      "lesson_range": [
        57,
        84
      ],
      "weight_percent": 20
    },
    {
      "topic": "Vision, NLP, and specialist model families",
      "lesson_range": [
        85,
        107
      ],
      "weight_percent": 14
    },
    {
      "topic": "Persistence, reproducibility, accelerators, and optimization",
      "lesson_range": [
        108,
        132
      ],
      "weight_percent": 14
    },
    {
      "topic": "Distributed training, deployment, tests, security, and capstone delivery",
      "lesson_range": [
        133,
        164
      ],
      "weight_percent": 16
    }
  ],
  "question_file_strategy": "Every lesson has a separate three-question knowledge-check file with protected answer keys. This blueprint does not itself implement a timed exam runner or certify a learner; those behaviors remain governed by the existing backend.",
  "practical_assessment": [
    "Complete a beginner or intermediate project with an implementation, tests, reproducible commands, and measured evaluation.",
    "For the capstone, run a model inference path with validated input and document limitations."
  ],
  "remediation_policy": "Map missed outcomes to the corresponding lesson, then retry with the linked exercise. Publish only after a technical and answer-ambiguity review.",
