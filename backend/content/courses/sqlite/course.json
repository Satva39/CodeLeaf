    "id": "sqlite-course",
    "slug": "sqlite",
    "title": "SQLite — From Beginner to Advanced",
    "description": "A visual-first, practice-driven course in SQLite setup, SQL querying, relational design, transactions, query optimization, application integration, concurrency, backup, security, advanced features and production readiness.",
    "category": "Database",
    "level": "Beginner to Advanced",
    "sort_order": 35,
    "version_scope": "SQLite 3.54.1 is the reference baseline checked 2026-10-20 (released 2026-10-16). Verify SELECT sqlite_version() and the actual library linked to the application. Optional modules and compile-time features may be absent.",
    "audience": [
      "students and beginner programmers",
      "web/mobile/desktop application developers",
      "embedded and IoT developers",
      "data analysts",
      "developers maintaining local or offline-first data"
    ],
    "prerequisites": [
      "Basic computer literacy; introductory SQL and programming knowledge are helpful but not required.",
      "Use a local SQLite CLI or a language binding for hands-on practice; CodeLeaf browser preview does not execute SQL."
    ],
    "estimated_workload_hours": 65,
    "lesson_count": 220,
    "module_count": 17,
    "learning_outcomes": [
      "Install SQLite tools and verify capabilities of the runtime used by an application.",
      "Create database files, tables, relationships, views and integrity constraints.",
      "Write SQL queries using joins, subqueries, CTEs, aggregates and window functions.",
      "Use type-affinity rules, STRICT tables, indexes, transactions and conflict handling appropriately.",
      "Integrate SQLite with safe parameter binding, error handling and application transaction boundaries.",
      "Configure journaling, inspect concurrency behavior, create verified backups and plan migrations.",
      "Evaluate JSON/JSONB, FTS5, R*Tree, generated columns, triggers and native APIs against runtime support.",
      "Diagnose query performance, test integrity and deliver a documented SQLite-backed application."
    ],
