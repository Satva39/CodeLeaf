{
  "course_slug": "sqlite",
  "tracks": [
    {
      "id": "sqlite-internals",
      "title": "SQLite Internals",
      "level": "specialist",
      "topics": [
        "B-tree and page organization",
        "database page layout and record format",
        "query parsing and virtual-machine execution",
        "pager/cache/journaling/recovery internals",
        "query planner implementation",
        "source organization and debugging"
      ]
    },
    {
      "id": "native-sqlite-development",
      "title": "Native SQLite Development",
      "level": "specialist",
      "topics": [
        "Connection and prepared statement APIs",
        "native memory management",
        "application-defined functions and collations",
        "virtual-table modules and VFS implementations",
        "building/linking SQLite",
        "native extension packaging and error handling"
      ]
    },
    {
      "id": "full-text-and-specialized-data",
      "title": "Full-Text and Specialized Data",
      "level": "advanced optional",
      "topics": [
        "FTS5 tokenizers and query syntax",
        "ranking/snippets/custom tokenizers",
        "R*Tree indexing",
        "advanced JSON/JSONB workflows",
        "extension compatibility"
      ]
    },
    {
      "id": "data-synchronization-offline-systems",
      "title": "Data Synchronization and Offline Systems",
      "level": "advanced optional",
      "topics": [
        "Session extension and change sets",
        "synchronization queues/idempotency",
        "duplicate request handling and conflict resolution",
        "recovery from interrupted synchronization",
        "when client-server synchronization is required"
      ]
    },
    {
      "id": "reliability-database-operations",
      "title": "Reliability and Database Operations",
      "level": "advanced optional",
      "topics": [
        "backup architecture and restore drills",
        "WAL maintenance",
        "integrity checks and migration deployment",
        "performance regression testing",
        "storage-failure assumptions",
        "monitoring and recovery objectives"
      ]
    },
    {
      "id": "sqlite-security",
      "title": "SQLite Security",
      "level": "advanced optional",
      "topics": [
        "defensive database configuration",
        "authorizer callbacks",
        "SQL injection prevention",
        "extension-loading restrictions",
        "encryption integration and filesystem permissions",
        "untrusted database files/resource limits/data retention/threat modeling"
      ]
    },
    {
      "id": "legacy-database-compatibility",
      "title": "Legacy Database Compatibility",
      "level": "advanced optional",
      "topics": [
        "identify embedded SQLite version",
        "check syntax support",
        "schema compatibility and migrations",
        "data import/export",
        "cross-version testing",
        "manage unavailable optional features"
      ]
    }
  ],
  "publication_rule": "Version-specific and build-dependent topics remain drafts until checked against official documentation and the target SQLite runtime."
}
