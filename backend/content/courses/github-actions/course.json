    "slug": "github-actions",
    "title": "GitHub Actions: Beginner to Professional",
    "description": "A visual-first, practice-oriented learning path for workflow automation, secure CI/CD, releases, reusable actions, runner operations, and production-minded delivery architecture.",
    "category": "Cloud & DevOps",
    "level": "Beginner to Advanced",
    "sort_order": 65,
    "version_scope": "GitHub.com Actions documentation checked 2026-10-20. Verify runtime, syntax, billing, plan, and GitHub Enterprise Server compatibility before using version-sensitive features.",
    "audience": [
      "Students",
      "Developers",
      "Open-source contributors",
      "DevOps and platform engineers",
      "Software teams"
    ],
    "prerequisites": [
      "Basic Git and GitHub usage",
      "Repository branches, commits, and pull requests",
      "Command-line fundamentals",
      "YAML key-value structure and indentation"
    ],
    "estimated_workload_hours": "30–50 hours for core concepts and guided practice, with additional time for optional specializations and the capstone (source blueprint estimate).",
    "lesson_count": 168,
    "module_count": 22,
    "learning_outcomes": [
      "Build automated lint, test, and build workflows.",
      "Use events, jobs, runners, expressions, outputs, artifacts, and caches correctly.",
      "Apply least privilege, secret hygiene, safe trigger design, and OIDC where supported.",
      "Design controlled multi-environment deployments and traceable releases.",
      "Build reusable workflows and custom actions with clear contracts.",
      "Troubleshoot and optimize workflow reliability, scale, and cost.",
      "Present a documented CI/CD capstone with success and selected failure-path evidence."
    ],
    "status": "draft",
