# Copy to .env. Never put these secrets in frontend/.env or commit .env.
APP_ENV=development
# Local-only: set true to preview imported draft courses before publishing. Keep false in production.
PREVIEW_DRAFT_COURSES=false
APP_NAME=CodeLeaf API
API_PREFIX=/api
FRONTEND_ORIGINS=http://localhost:5173

# Example: postgresql+psycopg://postgres:password@localhost:5432/CodeLeaf
DATABASE_URL=postgresql+psycopg://codeleaf:dev_only_password_change_me@localhost:5432/codeleaf

# Generate a long random key, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret-before-running-auth
JWT_TTL_SECONDS=86400
COOKIE_SECURE=false

# Razorpay test-mode credentials only during development
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_MAX_PLAN_ID=
# Razorpay subscriptions use a finite total_count. Confirm provider limits and billing terms before production.
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=1200

# Account lifecycle email delivery. Local test mode exposes a manual action link in API responses;
# it does not send email and must remain false in production.
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_TEST_MODE=false
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# PostgreSQL-backed throttling for login, registration, and account-action endpoints.
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_ATTEMPTS=8
